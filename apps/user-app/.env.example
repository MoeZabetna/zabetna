# Copy to .env and fill in. Both values come from the Supabase dashboard
# (Project Settings -> API) or `pnpm dlx supabase projects api-keys`.
# The anon key is publishable — safe in a client bundle. Never put the
# service role key in an EXPO_PUBLIC_* variable: it bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
